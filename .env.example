# Скопируй в .env и заполни то, что нужно — все переменные необязательны,
# без .env офис стартует с настройками по умолчанию (кроме подписки Claude Code).

# Режим имитации: агенты отвечают заготовками без вызова claude — можно посмотреть
# весь интерфейс (доску, ревью, диффы, миссии) без подписки Claude Code и без CLI.
# 0/пусто — реальные агенты (нужен залогиненный `claude`), 1 — имитация.
AO_FAKE=0

# Путь к бинарнику Claude Code CLI. Если не задано — ищем `claude` в PATH
# (на Windows — claude.cmd/claude.exe), затем ~/.local/bin/claude.
#AO_CLAUDE_BIN=/usr/local/bin/claude

# Модель по умолчанию для агентов и лимит ходов на одну задачу.
#AO_MODEL=sonnet
#AO_MAX_TURNS=100

# Таймауты на claude -p, после которых процесс убивается целиком (killpg): на одну
# задачу и на планирование миссии (секунды).
#AO_TASK_TIMEOUT=5400
#AO_PLAN_TIMEOUT=900

# Адрес и порт сервера. 127.0.0.1 — только с этого компьютера; 0.0.0.0 — видно
# в локальной сети (например, с телефона), см. README «С телефона».
#AO_HOST=127.0.0.1
#AO_PORT=8600

# Telegram-мост: токен бота от @BotFather и список tg_id через запятую, кому
# бот отвечает (остальным — молчит и показывает их id). Пусто — мост выключен.
# См. README «Свой бот в Telegram».
#AO_TG_TOKEN=
#AO_TG_ADMINS=

# Путь к бинарнику Allure CLI — для кнопки «Открыть в Allure» на отчёте тестов.
# Не найден/не задан — кнопки просто нет, сам отчёт всё равно строится.
#AO_ALLURE_BIN=

# Сводка «Что происходит?»: как часто (в минутах) Ральф пересобирает факты и какой
# моделью пишет текст поверх них (вызов claude -p — только если факты изменились).
#AO_DIGEST_INTERVAL_MIN=15
#AO_DIGEST_MODEL=haiku

# Автосводка в Telegram: раз в сколько минут бот сам присылает её всем AO_TG_ADMINS
# (первая — не сразу после старта, а через это время; 0 — только по запросу/команде).
# Если с прошлой отправки ничего не изменилось — по умолчанию (1) молчать, раз в час
# короткая строка «без изменений»; 0 — слать полную сводку каждый раз, даже без изменений.
#AO_TG_DIGEST_MIN=20
#AO_TG_DIGEST_QUIET=1

# test_hub для блока "последний прогон" в сводке: служебная учётка (уже заведена в
# test_hub под этими логином/паролем по умолчанию) и карта "папка репозитория" ->
# "имя проекта в test_hub" вида auto_tests_vshgu=VSHGU,foo=BAR (через запятую; не
# указан репозиторий — берётся имя папки как есть).
#AO_TESTHUB_LOGIN=tg_bot
#AO_TESTHUB_PASSWORD=tg_bot
#AO_TESTHUB_PROJECTS=auto_tests_vshgu=VSHGU

# Куда класть рантайм-состояние (задачи, worktree'ы, память агентов, логи).
# По умолчанию — workspace/ рядом с проектом.
#AO_WORKSPACE=./workspace

# Куда создавать новые проекты (кнопка «➕ Новый проект» в офисе/Telegram, см.
# README «Новый проект из офиса»). По умолчанию — папка, в которой лежит сам
# офис (обычно ~/PycharmProjects).
#AO_PROJECTS_DIR=~/PycharmProjects
